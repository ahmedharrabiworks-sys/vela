 "captions": [
  {
   "text": "الساعة تسع وسبعة",
   "words": [
    0,
    1,
    2
   ],
   "from": 6,
   "to": 63,
   "line": 0
  },
  {
   "text": "وأربعين بالليل.",
   "words": [
    3,
    4
   ],
   "from": 63,
   "to": 100,
   "line": 0
  },
  {
   "text": "العيادة مسكّرة...",
   "words": [
    5,
    6
   ],
   "from": 100,
   "to": 166,
   "line": 0
  },
  {
   "text": "والتلفون يرن.",
   "words": [
    7,
    8
   ],
   "from": 166,
   "to": 218,
   "line": 0
  },
  {
   "text": "مريض يبي يحجز.",
   "words": [
    9,
    10,
    11
   ],
   "from": 218,
   "to": 279,
   "line": 1
  },
  {
   "text": "ما أحد يرد.",
   "words": [
    12,
    13,
    14
   ],
   "from": 279,
   "to": 320,
   "line": 1
  },
  {
   "text": "فيتصل على العيادة",
   "words": [
    15,
    16,
    17
   ],
   "from": 320,
   "to": 369,
   "line": 1
  },
  {
   "text": "اللي جنبك.",
   "words": [
    18,
    19
   ],
   "from": 369,
   "to": 397,
   "line": 1
  },
  {
   "text": "كل مكالمة ما ترد",
   "words": [
    20,
    21,
    22,
    23
   ],
   "from": 397,
   "to": 454,
   "line": 2
  },
  {
   "text": "عليها، مريض راح عليك.",
   "words": [
    24,
    25,
    26,
    27
   ],
   "from": 454,
   "to": 554,
   "line": 2
  },
  {
   "text": "والناس ما تنتظر.",
   "words": [
    28,
    29,
    30
   ],
   "from": 554,
   "to": 612,
   "line": 2
  },
  {
   "text": "هذا Vela.",
   "words": [
    31,
    32
   ],
   "from": 612,
   "to": 660,
   "line": 3
  },
  {
   "text": "موظف الاستقبال الذكي",
   "words": [
    33,
    34,
    35
   ],
   "from": 660,
   "to": 725,
   "line": 3
  },
  {
   "text": "اللي ما ينام.",
   "words": [
    36,
    37,
    38
   ],
   "from": 725,
   "to": 769,
   "line": 3
  },
  {
   "text": "يرد على كل مكالمة،",
   "words": [
    39,
    40,
    41,
    42
   ],
   "from": 769,
   "to": 826,
   "line": 4
  },
  {
   "text": "بالعربي أو الإنجليزي.",
   "words": [
    43,
    44,
    45
   ],
   "from": 826,
   "to": 886,
   "line": 4
  },
  {
   "text": "يعرف خدماتك، وأسعارك،",
   "words": [
    46,
    47,
    48
   ],
   "from": 886,
   "to": 951,
   "line": 4
  },
  {
   "text": "ومواعيد دوامك.",
   "words": [
    49,
    50
   ],
   "from": 951,
   "to": 989,
   "line": 4
  },
  {
   "text": "ولما يكون المريض جاهز،",
   "words": [
    51,
    52,
    53,
    54
   ],
   "from": 989,
   "to": 1055,
   "line": 5
  },
  {
   "text": "يحجز له الموعد في",
   "words": [
    55,
    56,
    57,
    58
   ],
   "from": 1055,
   "to": 1100,
   "line": 5
  },
  {
   "text": "جدولك على طول.",
   "words": [
    59,
    60,
    61
   ],
   "from": 1100,
   "to": 1141,
   "line": 5
  },
  {
   "text": "بدون حجز مكرر، وما يحجز",
   "words": [
    62,
    63,
    64,
    65,
    66
   ],
   "from": 1141,
   "to": 1232,
   "line": 5
  },
  {
   "text": "أبداً في يوم إجازة.",
   "words": [
    67,
    68,
    69,
    70
   ],
   "from": 1232,
   "to": 1295,
   "line": 5
  },
  {
   "text": "تشوف كل مكالمة، وكل",
   "words": [
    71,
    72,
    73,
    74
   ],
   "from": 1295,
   "to": 1362,
   "line": 6
  },
  {
   "text": "محادثة، وكل حجز.",
   "words": [
    75,
    76,
    77
   ],
   "from": 1362,
   "to": 1434,
   "line": 6
  },
  {
   "text": "كله في مكان واحد.",
   "words": [
    78,
    79,
    80,
    81
   ],
   "from": 1434,
   "to": 1495,
   "line": 6
  },
  {
   "text": "واحنا نجهز لك كل شي.",
   "words": [
    82,
    83,
    84,
    85,
    86
   ],
   "from": 1495,
   "to": 1567,
   "line": 7
  },
  {
   "text": "رقمك يبقى نفسه.",
   "words": [
    87,
    88,
    89
   ],
   "from": 1567,
   "to": 1634,
   "line": 7
  },
